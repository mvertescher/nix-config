/*
# ---------------------------------------
# cybr-waybar     waybar modules (part of cybrcore)
# Project:        https://github.com/cybrcore/cybr-waybar
# Author:         scherrer-txt   |   License:     GPL-3.0
# Source:         ~/.config/waybar/modules.jsonc
# ---------------------------------------
*/
{
	/* ARROWS */
	"custom/arrow-right-no1": {
		"format": "  ",
		"tooltip": false
	},
	"custom/arrow-left-no1": {
		"format": "  ",
		"tooltip": false
	},
	"custom/arrow-right-re0": {
		"format": "  ",
		"tooltip": false
	},
	"custom/arrow-left-re0": {
		"format": "  ",
		"tooltip": false
	},
	"custom/arrow-right-gr0": {
		"format": "  ",
		"tooltip": false
	},
	"custom/arrow-left-gr0": {
		"format": "  ",
		"tooltip": false
	},
	/* BRIGHTNESS */
	"custom/brightness": {
		"exec": "~/.config/waybar/scripts/bright-status.sh",
		"interval": 1,
		"return-type": "json",
		"format": "{text}",
		"markup": true,
		"tooltip": true,
		"on-scroll-up": "~/.config/waybar/scripts/bright.sh up",
		"on-scroll-down": "~/.config/waybar/scripts/bright.sh down"
	},
	/* BATTERY */
	"battery": {
		"format": "{capacity}% {icon}",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{time} {icon}",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"tooltip": false,
		"interval": 5,
		"states": {
			"warning": 30,
			"critical": 10
		}
	},
	/* BLUETHOOTH */
	/* Upstream's on-click opened blueman-manager through
	   `~/.config/hypr/scripts/toggle_scratchpad.sh`, a script upstream
	   ships and this repo does not write, so the click did nothing at
	   all. Dropped rather than repaired: `hardware.bluetooth.enable` is
	   false here, so there is no stack for a manager to talk to, blueman
	   is not installed, and no bar in config.jsonc lists this module
	   anyway. Same call as `custom/updates` further down. */
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-connected": " {num_connections}",
		"format-connected-battery": "{icon} {num_connections}",
		"format-icons": [
			"󰥇",
			"󰤾",
			"󰤿",
			"󰥀",
			"󰥁",
			"󰥂",
			"󰥃",
			"󰥄",
			"󰥅",
			"󰥆",
			"󰥈"
		],
		"tooltip-format": "{controller_alias}\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{icon} {device_battery_percentage}%"
	},
	/* CLOCKS */
	"clock#time": {
		"format": " {:%H.%M:%OS} ",
		"interval": 1,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "left",
			"on-scroll": 1,
			"on-click-right": "mode"
		}
	},
	"clock#date": {
		"format": "{:%Y/%m/%d}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "left",
			"on-scroll": 1,
			"on-click-right": "mode"
		}
	},
	/* The five modules below used to open a btop or nvtop scratchpad on
	   click. Dropped, because nothing here can make that work: the
	   handlers called `~/.config/hypr/scripts/toggle_scratchpad.sh`,
	   which upstream ships and this repo does not write, and no window
	   rules exist for a `scratchpad-large` workspace or the
	   `scratchpad-*` classes either. Installing btop and nvtop would not
	   have revived them -- the click ran a script that is not there, so
	   it did nothing at all rather than half-working. Same call as the
	   `custom/updates` on-click further down.

	   Reviving the feature means writing the toggle script and its
	   window rules first, at which point the handlers can come back.
	   None of these five is in an enabled bar today -- BAR 2 in
	   config.jsonc, the only bar that lists them, is commented out. */
	/* CPU USAGE */
	"cpu": {
		"format": " {usage}%",
		"tooltip-format": "CPU",
		"interval": 2
	},
	/* The three sensor modules below used to name `/sys/class/hwmon/hwmonN`
	   paths. That numbering is handed out in driver probe order and is
	   not stable across boots, so an index only ever describes the
	   machine it was written on, on the day it was written. On this one
	   they had already drifted onto the wrong devices entirely: hwmon4 is
	   the mt7921 wifi radio, so "CPU" reported the wireless card's
	   temperature, and hwmon2 is k10temp, which has no temp2_input, so
	   "GPU" threw in its constructor and never rendered at all.

	   `hwmon-path-abs` plus `input-filename` resolves by device instead:
	   waybar takes the one `hwmon*` directory under the path it is given
	   and appends the filename, so the node is reached through the
	   driver's PCI address rather than a global counter. Both options
	   accept an array and the first entry that resolves wins, which is
	   how the AMD and Intel spellings sit side by side.

	   A PCI address is still a hardware fact, but a stable one:
	   `0000:00:18.3` is the AMD data-fabric function, fixed by the
	   architecture on every single-socket Zen part, and a GPU's slot
	   address does not move unless the card does. On new hardware check
	   `grep . /sys/class/hwmon/hwmonN/name` and
	   `readlink -f /sys/class/hwmon/hwmonN`. Getting it wrong costs the
	   module and not the bar -- waybar logs the constructor's throw and
	   carries on without it.

	   Nothing here can read an NVIDIA card: the proprietary driver
	   exposes no hwmon node, so on a hybrid machine the GPU readings are
	   the AMD part's. */
	"temperature#cpu": {
		"critical-threshold": 90,
		"hwmon-path-abs": [
			"/sys/bus/pci/drivers/k10temp/0000:00:18.3/hwmon",
			"/sys/devices/platform/coretemp.0/hwmon"
		],
		"input-filename": "temp1_input",
		"format-critical": "{icon} {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"󰈸"
		],
		"tooltip-format": "CPU",
		"interval": 2
	},
	/* GPU USAGE */
	"custom/gpu-usage": {
		/* `gpu_busy_percent` is an amdgpu attribute on the PCI device
		   itself, not something under hwmon; the old path looked for it
		   beneath a hwmon directory belonging to the wifi radio, where it
		   has never existed. A `custom` module runs its command through
		   `/bin/sh -c`, so unlike `temperature` it can glob and does not
		   have to name an address at all. exec-if keeps it hidden on a
		   machine with no AMD GPU rather than printing cat's error. */
		"exec": "cat /sys/bus/pci/drivers/amdgpu/*/gpu_busy_percent",
		"exec-if": "ls /sys/bus/pci/drivers/amdgpu/*/gpu_busy_percent >/dev/null 2>&1",
		"format": "GPU: {}%",
		"return-type": "",
		"interval": 2
	},
	"temperature#gpu": {
		"critical-threshold": 90,
		"hwmon-path-abs": [
			"/sys/bus/pci/drivers/amdgpu/0000:11:00.0/hwmon"
		],
		"input-filename": "temp1_input",
		"format-critical": "{icon} {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"󰈸"
		],
		"tooltip-format": "GPU",
		"interval": 2
	},
	/* RAM USAGE */
	"memory": {
		"format": " {}%",
		"tooltip-format": "RAM",
		"interval": 2
	},
	/* NETWORK */
	/* This module *is* in the live bar, which made its dead on-click
	   worse than the ones above rather than better. It called upstream's
	   missing `toggle_scratchpad.sh` to open nm-connection-editor, and
	   neither the script nor the editor is here.

	   Dropped rather than installed, which is the opposite call from
	   `pulseaudio` below and for a concrete reason: this config sets
	   `networking.networkmanager.enable = false` and leaves the
	   interfaces to `networking.useDHCP`, so nm-connection-editor would
	   open onto a daemon that is not running and be able to do nothing.
	   The module itself is unaffected either way -- it reads the kernel's
	   interface state directly and never needed NetworkManager. */
	"network": {
		"format-wifi": "",
		"format-ethernet": "",
		"tooltip-format-wifi": "Network: <b>{essid}</b>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"tooltip-format-ethernet": "Network: <b>{essid}</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"format-linked": "󰈀 {ifname} (No IP)",
		"format-disconnected": "󰖪 ",
		"tooltip": true,
		"interval": 2
	},
	/* AUDIO */
	"pulseaudio": {
		"format": "  {volume}%",
		"format-muted": "  MUTE",
		"interval": 1,
		"tooltip-format": "{desc}, {volume}%",
		/* Invoked directly, not through upstream's `toggle_scratchpad.sh`,
		   which this repo does not write -- so as shipped the click did
		   nothing. Kept rather than dropped, unlike `network` above: a
		   volume mixer is worth having on a workstation, pipewire's pulse
		   server is enabled so pavucontrol has something to talk to, and
		   installing it is one line in ../default.nix, which does. */
		"on-click": "pavucontrol",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	},
	/* LOGO */
	"custom/nixos": {
		"format": "  ",
		"tooltip": false,
		"on-click": "~/.config/rofi/scripts/powermenu/powermenu",
		"on-click-right": "rofi -show drun"
	},
	/* MUSIC */
	"custom/music": {
		"format": "{0}",
		"return-type": "json",
		"max-length": 40,
		"escape": true,
		"tooltip": true,
		"exec": "~/.config/waybar/scripts/mediaplayer.py",
		"on-click": "playerctl play-pause",
		"on-scroll-up": "playerctl next",
		/* Upstream's right-click chose which MPRIS player the module
		   follows, through one of two scripts -- `switch-to-spotify.sh`
		   and the commented-out `switch-media-player.sh` -- neither of
		   which is in ./scripts. Both dropped. This is not a matter of
		   installing something: the exec is mpris-status, which takes its
		   player as a `--player` argument read once at startup, so
		   switching at runtime needs somewhere to persist the choice and a
		   signal to make the module reread it. That is a feature to build,
		   not a path to correct. */
		"on-scroll-down": "playerctl previous"
	},
	/* NOTIFICATIONS */
	"custom/notifications": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"notification": "󰀧",
			"none": "󰀧",
			"dnd-notification": "󰳤",
			"dnd-none": "󰳤",
			"inhibited-notification": "<sup></sup>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<sup></sup>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	/* UPDATES */
	/* Upstream ran `waybar-updates`, a pacman/AUR helper that is not in
	   nixpkgs and would mean nothing on NixOS. The exec token below is
	   replaced with a store path by ../default.nix. It flags a pending
	   reboot (booted vs current system) and a config that has not been
	   switched, or had its inputs relocked, in a while — all from
	   local state, no network — and reports nothing when there is nothing
	   to say, which hides the module. The old on-click is gone with it:
	   it drove `nu -c upall`, another pacman-ism. */
	"custom/updates": {
		"format": "{icon}",
		"return-type": "json",
		"tooltip": true,
		"escape": true,
		"format-icons": {
			"pending-updates": "󰋠",
			"updated": ""
		},
		"exec": "@nix-updates@",
		"interval": 300,
		"signal": 9,
		"hide-empty-text": true
	},
	/* RECORDER */
	"custom/wf-recorder": {
		"format": "{}",
		"interval": "once",
		"exec": "echo ''",
		"tooltip": false,
		"exec-if": "pgrep 'wf-recorder'",
		/* on-click ran `$HOME/.config/hypr/scripts/rofi/recording`, one
		   more upstream path this repo does not write. Dropped for the
		   same reason as the bluetooth handler above; wf-recorder is not
		   installed either, so exec-if never passes and the module never
		   appears in the first place. */
		"signal": 8
	},
	/* LANG */
	"hyprland/language": {
		"format": "{}",
		"format-cs": "CZ",
		"format-en": "US",
		"on-click": "hyprctl switchxkblayout all next",
		"on-scroll-up": "hyprctl switchxkblayout all next",
		"on-scroll-down": "hyprctl switchxkblayout all next"
	},
	/* WINDOW */
	"hyprland/window": {
		"format": "{}",
		"max-length": 80,
		"rewrite": {
			"(.*) - Mozilla Firefox": "$1 󰈹",
			"(.*) - Visual Studio Code": "$1 󰨞",
			"(.*)Spotify": "Spotify 󰓇",
			"(.*) - Obsidian": "Obsidian ",
			"(.*)Steam": "Steam 󰓓"
		},
		"separate-outputs": false
	},
	/* WORKSPACES */
	"hyprland/workspaces": {
		"disable-scroll": true,
		"active-only": false,
		"all-outputs": false,
		"enable-bar-scroll": true,
		"format": "{icon}",
		"format-icons": {
			"1": "1", /* 󰈹 firefox */
			"2": "2", /* 󰎄 music*/
			"3": "3", /* 󰀆 chat */
			"4": "4",
			"5": "5",
			"6": "6",
			"7": "7",
			"8": "8",
			"9": "9", /* 󰒔 settings & info */
			"10": "1", /* 󰈹 firefox */
			"11": "2", /* 󱃖 code */
			"12": "3", /* 󰑕 obsidian */
			"13": "4", /* 󰇟 figma */
			"14": "5", /* 󰩳 gaming */
			"15": "6",
			"16": "7",
			"17": "8",
			"18": "9",
			"19": "10",
			"20": "20",
			"21": "21",
			"22": "22",
			"23": "23",
			"24": "24",
			"25": "25",
			"26": "26",
			"27": "27"
		},
		"on-scroll-up": "hyprctl dispatch workspace r-1",
		"on-scroll-down": "hyprctl dispatch workspace r+1",
		"on-click": "activate",
		"sort-by-number": true
	},
	/* TRAY */
	"tray": {
		"icon-size": 16,
		"spacing": 10
	}
}
