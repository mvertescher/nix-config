#!/usr/bin/env bash

set -eux

hosts=(terra server)

is_known_host() {
  local host="$1"
  for h in "${hosts[@]}"; do
    [[ "$h" == "$host" ]] && return 0
  done
  return 1
}

switch_to() {
  sudo nixos-rebuild switch --flake ".#$1"
}

if [ "$#" -eq 0 ]; then
  current_host="$(hostname)"
  if is_known_host "$current_host"; then
    switch_to "$current_host"
  else
    echo "hostname '$current_host' does not match a known configuration (${hosts[*]})"
    exit 1
  fi
elif is_known_host "$1"; then
  switch_to "$1"
else
  echo "unknown argument"
  exit 1
fi
